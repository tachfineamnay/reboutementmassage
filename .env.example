GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
SITE_URL=https://domaine-final.tld
NEXT_PUBLIC_SITE_URL=https://domaine-final.tld
CANONICAL_HOST=domaine-final.tld

# Admin dashboard / security
ADMIN_REPORTING_TIMEZONE=Europe/Paris
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15
ANALYTICS_EVENT_RATE_LIMIT_PER_MINUTE=120

# Meta Pixel (Sayulita + conversion tracking)
NEXT_PUBLIC_META_PIXEL_ID=880602994184552

# TikTok Pixel (optional)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Analytics 4 + GTM (optional, Growth landings)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# SEO automation / Google APIs (optional)
INDEXNOW_KEY=
INDEXNOW_HOST=
INDEXNOW_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=
PAGESPEED_API_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# CDMX campaign WhatsApp number (digits only, no +) — fixed Mexico line
NEXT_PUBLIC_CDMX_WHATSAPP_NUMBER=525633003042

# Growth CMS seed (set to 0 to skip CDMX seed data)
SEED_GROWTH_CDMX=1

# Optional Go High Level settings
# vide = mock en local, live en production ; forcer mock/live si besoin
GHL_LEAD_MODE=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_SOURCE=Landing Méthode TMS
GHL_ASSIGNED_USER_ID=
GHL_DEFAULT_TAGS=source-site-premium,channel-ghl
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_WORKFLOW_ID=
GHL_TIMEOUT_MS=10000

# Existing GHL contact custom fields (IDs or stable keys only; leave empty to use temporary visible-name lookup)
GHL_FIELD_INTENTION_ID=
GHL_FIELD_MAIN_OBJECTIVE_ID=
GHL_FIELD_MAIN_OBSTACLE_ID=
GHL_FIELD_PRIOR_EXPERIENCE_ID=
GHL_FIELD_READINESS_ID=
GHL_FIELD_TIMING_URGENCY_ID=
GHL_FIELD_CURRENT_LOCATION_ID=
GHL_FIELD_ZONES_OF_INTEREST_ID=
GHL_FIELD_CHOSEN_FORMAT_ID=
GHL_FIELD_SESSION_LOCATION_PREFERENCE_ID=
GHL_FIELD_KNOWN_CONTRAINDICATION_ID=
GHL_FIELD_PRE_SESSION_NOTES_ID=
GHL_FIELD_QUALIFICATION_SCORE_ID=
GHL_FIELD_ROLE_FUNCTION_ID=
GHL_FIELD_COMPANY_ESTABLISHMENT_ID=
GHL_FIELD_ESTABLISHMENT_TYPE_ID=
GHL_FIELD_NUMBER_OF_PARTICIPANTS_ID=
GHL_FIELD_DURATION_ID=
GHL_FIELD_HAS_SPACE_TO_HOST_TRAINING_ID=
GHL_FIELD_CURRENT_PRACTICE_SUMMARY_ID=
GHL_FIELD_CURRENT_SESSION_PRICE_ID=
GHL_FIELD_INTERNAL_NOTES_ID=
GHL_FIELD_WEBINAR_DATE_ID=
GHL_FIELD_FORM_LANGUAGE_ID=
GHL_FIELD_MARKETING_CONSENT_ID=
GHL_FIELD_INFORMAL_TONE_ID=
GHL_FIELD_OTHER_SPECIFY_ID=

# Notifications email B2B via Resend
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=Gregory Tordjman <leads@domaine-final.tld>
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_BCC=

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tms_db
# Optionnel : synchroniser le schéma au démarrage. Une erreur Prisma ne bloque
# jamais le serveur web. Laisser à 0 si la synchronisation est gérée séparément.
RUN_MIGRATE_DEPLOY=1
RUN_DB_PUSH=0

# Auth admin (générer avec: openssl rand -base64 32)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# OpenAI Article Studio (server-side only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional but recommended for dashboard-stored secrets.
# Generate with: openssl rand -base64 32
ADMIN_SETTINGS_ENCRYPTION_KEY=

# Stockage uploads (laisser vide pour utiliser ./uploads/ en local)
# En production Coolify : /app/storage/uploads
UPLOAD_DIR=
UPLOAD_PUBLIC_PATH=/uploads
